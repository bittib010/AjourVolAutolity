// Title: Credential-looking strings
// Why: Passwords on command lines (net use, runas, psexec -p, mysql -p), connection strings and HTTP Basic auth headers left in memory. Sensitive: handle as live credentials.
// MITRE: T1552.001
strings
| where String matches regex @"(?i)(password\s*[=:]\s*\S{3,}|pwd\s*=\s*\S{3,}|authorization:\s*basic\s+[a-z0-9+/=]{8,}|net\s+use\s+\S+\s+\S+\s+/user:|\s-p\s+\S{4,}\s.*\\\\|psexec.*\s-p\s)"
| summarize Hits = count() by String = substring(String, 0, 400)
| take 500
