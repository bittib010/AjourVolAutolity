// Title: LSA secrets and cached domain logons
// Why: LSA secrets can hold cleartext passwords (DefaultPassword = autologon, _SC_<service> = service account passwords, RAS/VPN credentials). Cached domain logons (DCC2) of privileged accounts on a workstation are a cracking target; the HashcatFormat column is ready for offline cracking (mode 2100).
// FalsePositives: $MACHINE.ACC, DPAPI_SYSTEM and NL$KM exist on every domain member and are informational.
// MITRE: T1003.004, T1003.005
union
    (lsadump | project Source = "LSA secret", Account = Key, Detail = Secret, HashcatFormat = "",
                       Meaning = case(Key == "DefaultPassword", "autologon password", Key startswith "_SC_", strcat("service password: ", substring(Key, 4)),
                                      Key == "$MACHINE.ACC", "machine account password", Key == "DPAPI_SYSTEM", "system DPAPI keys",
                                      Key == "NL$KM", "cached-credentials key", Key matches regex @"(?i)^(RasDialParms|RasCredentials|L\$_Ras)", "VPN/RAS credentials", "")),
    (cachedump | project Source = "Cached domain logon", Account = strcat(Domain, "\\", Username), Detail = Domainname,
                         HashcatFormat = strcat("$DCC2$10240#", tolower(Username), "#", replace_string(Hash, " ", "")), Meaning = "DCC2 hash")
| order by Source asc, Account asc
